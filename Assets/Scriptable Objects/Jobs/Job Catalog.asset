  m_Name: Job Catalog
  m_EditorClassIdentifier: 
  stories:
  - location: 0
    title: Investigate Ward Disappearances
    story: Patients keep vanishing at night.
  - location: 0
    title: Cleanse Room 13
    story: A nurse swears the bed is never empty.
  - location: 0
    title: Recover Night Shift Evidence
    story: The night staff never came home.
  - location: 0
    title: Secure Operating Theater
    story: The surgery never finished.
  - location: 0
    title: Clear Waiting Room Disturbance
    story: No one ever leaves through the front door.
  - location: 1
    title: Silence Cell Block Echoes
    story: Crying comes from the empty cells.
  - location: 1
    title: Secure Abandoned Facility
    story: The guards fled and left the doors open.
  - location: 1
    title: Extract Solitary Wing Evidence
    story: Something is still serving time.
  - location: 1
    title: Investigate Yard Anomaly
    story: They say the count is always off by one.
  - location: 1
    title: Retrieve Warden's Records
    story: His last order is still on the desk.
  - location: 2
    title: Appraise Haunted Estate
    story: Every portrait seems to stare.
  - location: 2
    title: Retrieve East Wing Documents
    story: The family never left the east wing.
  - location: 2
    title: Investigate Dining Hall Activity
    story: The table is set every night.
  - location: 2
    title: Cleanse Grand Ballroom
    story: The music starts at midnight, but no one plays.
  - location: 2
    title: Search Servant Quarters
    story: They're still waiting for their wages.
